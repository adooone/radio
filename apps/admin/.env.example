# Same variable names as @radio/player. Set production values in the Vercel project (Settings → Environment Variables).
VITE_API_URL=http://localhost:6870
VITE_SOCKET_URL=ws://localhost:6871
# development | production | preview — must match isDev / isProd / isPreview in src/services/env.ts
VITE_APP_ENV=development

# The dev server proxies /api on its own origin (vite.config.ts), so a browser
# elsewhere on the tailnet needs only this port open. Point VITE_API_URL at the
# page's origin and ADMIN_API_PROXY at the wave to use: the local dev wave by
# default, or the pm2 station on 6970.
# VITE_API_URL=http://deimos:3001
# ADMIN_API_PROXY=http://localhost:6970
