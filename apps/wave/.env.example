PORT=6870
SOCKET_PORT=6871
MEDIA_ROOT_PATH=/var/www/p-sound
MEDIA_BASE_URL=/media/p-sound
MEDIA_INBOX_PATH=/var/www/p-sound-inbox
DISCOGS_TOKEN=
# The stream the player plays and the relay the turntable publishes to.
# Defaults shown; the nginx-rtmp container publishes 1935 and 8069 to the host.
STREAM_KEY=test
RTMP_PUBLISH_URL=rtmp://127.0.0.1:1935/live
RTMP_HTTP_URL=http://127.0.0.1:8069
